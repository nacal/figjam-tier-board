{
  "name": "figjam-tier-board",
  "version": "0.1.0",
  "private": true,
  "description": "A FigJam plugin that manages the tier rows of a tier board. The things you rank are plain FigJam stickies.",
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build:test && vitest run",
    "test:watch": "vitest",
    "build:test": "build-figma-plugin --typecheck"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "^1.100.2",
    "@types/node": "^26.4.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": "^10.29.8"
  },
  "figma-plugin": {
    "editorType": [
      "figjam"
    ],
    "id": "1677535397231689072",
    "name": "Tier Board",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ]
    }
  }
}
